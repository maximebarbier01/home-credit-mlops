# Copier ce fichier en .env (jamais commite, voir .gitignore) et
# renseigner de vraies valeurs locales. Docker Compose charge .env
# automatiquement depuis le meme dossier que docker-compose.yml, et en
# construit PREDICTION_DB_URL pour le service api.
#
# Eviter les caracteres speciaux d'URL (@ : / % espace) dans le mot de
# passe : docker-compose.yml construit PREDICTION_DB_URL directement a
# partir de ces variables sans encodage, un caractere special le
# casserait silencieusement.
POSTGRES_DB=home_credit_monitoring
POSTGRES_USER=home_credit
POSTGRES_PASSWORD=changeme

# PREDICTION_DB_URL n'a plus de valeur par defaut SQLite : l'API exige une
# vraie base PostgreSQL des que le logging est actif (par defaut). Docker
# Compose la construit automatiquement depuis les valeurs ci-dessus. Pour
# lancer l'API hors Docker (poetry run uvicorn) contre le PostgreSQL de
# Docker Compose, exporter dans le shell (pas ici, .env n'est lu que par
# Docker Compose) :
#   export PREDICTION_DB_URL="postgresql+psycopg://home_credit:changeme@127.0.0.1:55432/home_credit_monitoring"
